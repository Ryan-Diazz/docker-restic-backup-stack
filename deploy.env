# =============================================================================
# GLOBAL SETTINGS
# =============================================================================
# Container timezone
# List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Amsterdam

# =============================================================================
# RESTIC SETTINGS
# =============================================================================

# Restic repository password
# IMPORTANT:
# - Use a long random password
# - !Changing this later makes old backups inaccessible!
RESTIC_PASSWORD=CHANGE_ME

# Cron schedule for restic backup + prune job
# Format:
# ┌───────────── minute (0 - 59)
# │ ┌─────────── hour (0 - 23)
# │ │ ┌───────── day of month (1 - 31)
# │ │ │ ┌─────── month (1 - 12)
# │ │ │ │ ┌───── day of week (0 - 7)
# │ │ │ │ │
# │ │ │ │ │
# * * * * *
#
# Example:
# 0 3 * * * = every day at 03:00
RESTIC_CRON=0 3 * * *
RESTIC_CRON_CHECK= 0 4 * * 0 # Every sunday on 04:00

# Local NAS mount path on the Docker host
# This should already be mounted via NFS or SMB
NAS_BACKUP_PATH=/mnt/nas-backups

# Local docket stacks path
# These folders will be added to the restic backup, no reproducable large files should be present in these folders
STACKS_PATH=/opt/docker/stacks

# =============================================================================
# APPFLOWY
# =============================================================================
# AppFlowy PostgreSQL
APPFLOWY_POSTGRES_HOST=appflowy-db 
APPFLOWY_POSTGRES_DB=appflowy
APPFLOWY_POSTGRES_USER=appflowy
APPFLOWY_POSTGRES_PASSWORD=secret

# =============================================================================
# OVERLEAF
# =============================================================================
# Overleaf MongoDB
OVERLEAF_MONGO_HOST=overleaf-mongo

# =============================================================================
# TEMPLATE — NEW SERVICE
# =============================================================================
#
# Copy this block when adding a new stack/service.
#
# Naming Convention:
#
# <SERVICE>_<TYPE>_<SETTING>
#
# Examples:
# NEXTCLOUD_MARIADB_HOST
# IMMICH_POSTGRES_PASSWORD
# GITEA_DATA_PATH
#
# =============================================================================

# SERVICE NAME
# ----------------------
# SERVICE_DATABASE_HOST=
# SERVICE_DATABASE_DB=
# SERVICE_DATABASE_USER=
# SERVICE_DATABASE_PASSWORD=

# =============================================================================
# EXAMPLE — NEXTCLOUD
# =============================================================================

# NEXTCLOUD_MARIADB_HOST=nextcloud-db
# NEXTCLOUD_MARIADB_DB=nextcloud
# NEXTCLOUD_MARIADB_USER=nextcloud
# NEXTCLOUD_MARIADB_PASSWORD=CHANGE_ME

# NEXTCLOUD_MARIADB_CRON=15 2 * * *

# =============================================================================
# EXAMPLE — IMMICH
# =============================================================================

# IMMICH_POSTGRES_HOST=immich-postgres
# IMMICH_POSTGRES_DB=immich
# IMMICH_POSTGRES_USER=immich
# IMMICH_POSTGRES_PASSWORD=CHANGE_ME

# IMMICH_POSTGRES_CRON=45 2 * * *
